# ==============================================================================
# HIPAA Safe Harbor PHI/PII De-Identification Gateway Configuration
# Copy this file to .env and fill in your credentials to enable live Cloud LLMs.
# ==============================================================================

# ------------------------------------------------------------------------------
# Foundation LLM Provider API Keys (Optional - Required only for live cloud API)
# ------------------------------------------------------------------------------
# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=

# Anthropic (Claude 3.5 Sonnet, Claude 3 Haiku)
ANTHROPIC_API_KEY=

# Google Gemini (Gemini 1.5 Flash, Gemini 1.5 Pro)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# Gateway Server & Runtime Settings
# ------------------------------------------------------------------------------
DEID_ENV=development
DEID_HOST=0.0.0.0
DEID_PORT=8000
DEFAULT_ADAPTER=mock
